<Project Sdk="Microsoft.NET.Sdk">

  <!-- Testy indikátorů Trading Desku pro ATAS bez ATAS: výpočty z TradingDeskProfile.cs a obal
       TradingDeskDraft.cs nad náhradními třídami API (AtasStubs.cs). Přeloží se i TradingDeskZones.cs.
       Spuštění z kořene repozitáře: dotnet run, s volbou project nastavenou na tests/atas. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AtasStubs.cs" />
    <Compile Include="ProfileTests.cs" />
    <Compile Include="../../static/atas/TradingDeskProfile.cs" />
    <Compile Include="../../static/atas/TradingDeskDraft.cs" />
    <Compile Include="../../static/atas/TradingDeskZones.cs" />
  </ItemGroup>

</Project>
