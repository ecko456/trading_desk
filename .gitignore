# Databáze a screenshoty jsou osobní data a do gitu nepatří.
# Repozitář je veřejný, takže tohle hlídá i omylem kliknutý commit v Codespace.
/data/*
!/data/.htaccess
!/data/uploads/
/data/uploads/*
!/data/uploads/.gitkeep

__pycache__/

# Výstupy sestavení .NET (indikátory pro ATAS a jejich testy). Kořenová bin/ jsou skripty, ta se verzuje.
/static/atas/bin/
/static/atas/obj/
/tests/atas/bin/
/tests/atas/obj/
